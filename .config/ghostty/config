# ~/.config/ghostty/config
# Ghostty configuration with a Nerd Font and iTerm2-style keybindings.
# Reload after editing: Cmd+Shift+, (or restart Ghostty)

# ─── Font ───────────────────────────────────────────────────────────────────
font-family = "MesloLGS Nerd Font"
font-size = 13

# ─── macOS niceties ─────────────────────────────────────────────────────────
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = false
scrollback-limit = 20000000

# ─── Keybindings (iTerm2 style) ─────────────────────────────────────────────

# Tabs (iTerm2: Cmd+T / Cmd+W / Cmd+] / Cmd+[ / Cmd+1..9)
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+right=next_tab
keybind = cmd+left=previous_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+6=goto_tab:6
keybind = cmd+7=goto_tab:7
keybind = cmd+8=goto_tab:8
keybind = cmd+9=last_tab

# Splits (iTerm2: Cmd+D vertical, Cmd+Shift+D horizontal)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Navigate splits (iTerm2: Cmd+Opt+Arrow)
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# Resize splits (iTerm2: Cmd+Ctrl+Arrow)
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Zoom current split (iTerm2: Cmd+Shift+Enter)
keybind = cmd+shift+enter=toggle_split_zoom

# Windows (iTerm2: Cmd+N new window, Cmd+Enter fullscreen)
keybind = cmd+n=new_window
keybind = cmd+enter=toggle_fullscreen

# Font size (iTerm2: Cmd+= / Cmd+- / Cmd+0)
keybind = cmd+equal=increase_font_size:1
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Clipboard (iTerm2: Cmd+C / Cmd+V)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Reload config
keybind = cmd+shift+comma=reload_config
